FROM node:22-bookworm AS build

WORKDIR /site

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG HUGO_ENVIRONMENT=staging
ENV HUGO_ENVIRONMENT=${HUGO_ENVIRONMENT}
RUN npm run build

FROM caddy:2-alpine

LABEL org.opencontainers.image.source="https://github.com/stellwerk-labs/developer-docs"

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /site/public/ /srv/

EXPOSE 8080
