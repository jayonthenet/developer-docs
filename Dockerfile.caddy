FROM node:22-slim AS build

RUN apt-get update && \
    apt-get install --yes --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /site

COPY package.json package-lock.json ./
COPY scripts/install-hugo.mjs ./scripts/install-hugo.mjs
RUN npm ci

COPY . .

ARG HUGO_ENVIRONMENT=staging
ENV HUGO_ENVIRONMENT=${HUGO_ENVIRONMENT}
RUN npm run build

FROM caddy:2-alpine

LABEL org.opencontainers.image.source="https://github.com/stellwerk-labs/developer-docs"

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /site/public/ /srv/

EXPOSE 8080
